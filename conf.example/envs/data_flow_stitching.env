# FlowStitchingProcessor -- combines flow-cache export slices of the same flow
# into a single stitched record once the flow goes idle or exceeds max duration
# (like Logstash's aggregate filter). Add
# metranova.processors.clickhouse.flow_stitching.FlowStitchingProcessor
# to a writer's processors list to enable it, then load these alongside
# the pipeline's other env files (e.g. base.env, data_flow.env).
CLICKHOUSE_FLOW_STITCH_TABLE=data_flow_anonymized
CLICKHOUSE_FLOW_STITCH_TTL=5 YEAR
CLICKHOUSE_FLOW_STITCH_TTL_COLUMN=start_time
CLICKHOUSE_FLOW_STITCH_PARTITION_BY=toYYYYMMDD(start_time)
CLICKHOUSE_FLOW_STITCH_INACTIVITY_TIMEOUT=630
CLICKHOUSE_FLOW_STITCH_MAX_TIMEOUT=86400
CLICKHOUSE_FLOW_STITCH_SWEEP_INTERVAL=30
CLICKHOUSE_FLOW_STITCH_IPV4_PREFIX=117
CLICKHOUSE_FLOW_STITCH_IPV6_PREFIX=48
