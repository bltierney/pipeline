PIPELINE_YAML=/app/pipelines/metadata_ip_geo.yml
IP_GEO_CSV_CONSUMER_USE_MAXMIND_DOWNLOAD=true
IP_GEO_CSV_CONSUMER_MAXMIND_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE
IP_GEO_CSV_CONSUMER_MAXMIND_LICENSE_KEY=YOUR_LICENSE_KEY_HERE
CLICKHOUSE_CACHER_TABLES=${CLICKHOUSE_AS_METADATA_TABLE},${CLICKHOUSE_IP_METADATA_TABLE}
CLICKHOUSE_METADATA_FORCE_UPDATE=false # Set to true to force updates even if no changes detected
IP_GEO_CSV_CONSUMER_ASN_FILES=/app/caches/GeoLite2-ASN-Blocks-IPv4.csv,/app/caches/GeoLite2-ASN-Blocks-IPv6.csv
IP_GEO_CSV_CONSUMER_LOCATION_FILES=/app/caches/GeoLite2-City-Locations-en.csv
IP_GEO_CSV_CONSUMER_IP_BLOCK_FILES=/app/caches/GeoLite2-City-Blocks-IPv4.csv,/app/caches/GeoLite2-City-Blocks-IPv6.csv
IP_GEO_CSV_CONSUMER_CUSTOM_IP_FILE=/app/caches/custom_ip_additions.yml
IP_GEO_CSV_CONSUMER_UPDATE_INTERVAL=86400

# IP_TRIE() dictionary (meta_ip_geo_dict) for IP -> geolocation/AS lookups,
# built the same way as the Scireg/Community dictionaries. Uncomment to
# override the defaults.
#CLICKHOUSE_IP_GEO_DICTIONARY_ENABLED=true
#CLICKHOUSE_IP_GEO_PREFIX_TABLE=meta_ip_geo_prefix
#CLICKHOUSE_IP_GEO_DICTIONARY_NAME=meta_ip_geo_dict
#CLICKHOUSE_IP_GEO_DICTIONARY_LIFETIME_MIN=600
#CLICKHOUSE_IP_GEO_DICTIONARY_LIFETIME_MAX=3600
